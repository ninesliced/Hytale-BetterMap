$C = "../../Common.ui";

@SectionTitleStyle = LabelStyle(
  FontSize: 18,
  TextColor: #93844c,
  RenderBold: true
);

@FieldLabelStyle = LabelStyle(
  FontSize: 14,
  TextColor: #96a9be,
  VerticalAlignment: Center
);

@CheckboxLabelStyle = LabelStyle(
  FontSize: 14,
  TextColor: #bfcdd5,
  VerticalAlignment: Center
);

@WarningTextStyle = LabelStyle(
  FontSize: 13,
  TextColor: #ff4a4a,
  RenderBold: true,
  VerticalAlignment: Center
);

@AsteriskLabelStyle = LabelStyle(
  FontSize: 14,
  TextColor: #ff4a4a,
  RenderBold: true,
  VerticalAlignment: Center
);

@NavButtonStyle = TextButtonStyle(
  Default: (Background: $C.@DefaultSquareButtonDefaultBackground, LabelStyle: (FontSize: 13, TextColor: #bfcdd5, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: $C.@DefaultSquareButtonHoveredBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: $C.@DefaultSquareButtonPressedBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

@NavButtonSelectedStyle = TextButtonStyle(
  Default: (Background: $C.@DefaultSquareButtonHoveredBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: $C.@DefaultSquareButtonHoveredBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: $C.@DefaultSquareButtonPressedBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

@NavButtonSelectedContainer = Group {
  LayoutMode: Left;
};

@NavButtonContainer = Group {
  LayoutMode: Left;
  Background: #1a2533(0.5);
};

@SectionCard = Group {
  LayoutMode: Top;
  Padding: (Full: 12);
  Background: #1a2533(0.6);
  OutlineColor: #3a4a5a(0.5);
  OutlineSize: 1;
};

@BannerButtonStyle = TextButtonStyle(
    Default: (Background: #000000(0)),
    Hovered: (Background: #FFFFFF(0.15)),
    Pressed: (Background: #FFFFFF(0.25)),
    Sounds: $C.@ButtonSounds
);

@FieldRow = Group {
  LayoutMode: Left;
  Anchor: (Height: 36);
  Padding: (Vertical: 4);
};

@CheckboxRow = Group {
  LayoutMode: Left;
  Anchor: (Height: 30);
  Padding: (Vertical: 2);
};

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 650, Height: 700);

    #Title {
      $C.@Title {
        @Text = "BetterMap Configuration";
      }

      TextButton #CloseBtn {
          Anchor: (Left: 12, Top: 4, Width: 64, Height: 24);
          Padding: (Left: 8, Top: 2);
          Text: "Close";
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 14, TextColor: #93844c, RenderBold: true)),
            Sounds: $C.@ButtonSounds,
          );
          Background: #000000(0.13);
      }
    }

    #Content {
      LayoutMode: Top;

      Group #NavBar {
        LayoutMode: Left;
        Anchor: (Height: 40);
        Padding: (Bottom: 10);
        Visible: true;

        Group {
          FlexWeight: 1;
          Anchor: (Height: 32);

          @NavButtonContainer #PlayerViewBtnContainer {
            Anchor: (Full: 0);
            Visible: false;

            TextButton #PlayerViewBtn {
              FlexWeight: 1;
              Text: "PLAYER SETTINGS";
              Style: @NavButtonStyle;
            }
          }

          @NavButtonSelectedContainer #PlayerViewBtnSelectedContainer {
            Anchor: (Full: 0);
            Visible: true;

            TextButton #PlayerViewBtnSelected {
              FlexWeight: 1;
              Text: "PLAYER SETTINGS";
              Style: @NavButtonSelectedStyle;
            }
          }
        }

        Group #AdminViewSpacer { Anchor: (Width: 10); Visible: false; }

        Group #AdminViewContainer {
          FlexWeight: 1;
          Anchor: (Height: 32);
          Visible: false;

          @NavButtonContainer #AdminViewBtnContainer {
            Anchor: (Full: 0);
            Visible: true;

            TextButton #AdminViewBtn {
              FlexWeight: 1;
              Text: "ADMIN SETTINGS";
              Style: @NavButtonStyle;
            }
          }

          @NavButtonSelectedContainer #AdminViewBtnSelectedContainer {
            Anchor: (Full: 0);
            Visible: false;

            TextButton #AdminViewBtnSelected {
              FlexWeight: 1;
              Text: "ADMIN SETTINGS";
              Style: @NavButtonSelectedStyle;
            }
          }
        }

        Group { Anchor: (Width: 10); }

        Group {
          FlexWeight: 1;
          Anchor: (Height: 32);

          @NavButtonContainer #HelpViewBtnContainer {
            Anchor: (Full: 0);
            Visible: true;

            TextButton #HelpViewBtn {
              FlexWeight: 1;
              Text: "HELP";
              Style: @NavButtonStyle;
            }
          }

          @NavButtonSelectedContainer #HelpViewBtnSelectedContainer {
            Anchor: (Full: 0);
            Visible: false;

            TextButton #HelpViewBtnSelected {
              FlexWeight: 1;
              Text: "HELP";
              Style: @NavButtonSelectedStyle;
            }
          }
        }
      }

      Group #PlayerView {
        Visible: true;
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group {
          LayoutMode: Top;
          Padding: (Right: 8);

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32);
            Background: #93844c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Personal Map Settings";
              Style: @SectionTitleStyle;
            }
          }

          @SectionCard {
            Anchor: (Top: 8);

            @FieldRow {
              Label { Text: "Max Zoom Out (Min Scale)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #PlayerMinScale { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Max Zoom In (Max Scale)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #PlayerMaxScale { Anchor: (Width: 120, Height: 28); }
            }
          }

          Group #PlayerLocationHeader {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #4c9c9c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Location HUD";
              Style: (FontSize: 18, TextColor: #4c9c9c, RenderBold: true);
            }
          }

          @SectionCard #PlayerLocationCard {
            Anchor: (Top: 8);
            Background: #1a2a2a(0.6);
            OutlineColor: #3a5a5a(0.5);

            @CheckboxRow {
              $C.@CheckBox #PlayerLocationEnabled { }
              Label { Text: "Enable Location HUD"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            Label {
              Anchor: (Top: 4, Left: 2);
              Text: "Warning: If you use multiple HUD mods, please install the MultipleHUD mod.";
              Style: @WarningTextStyle;
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "HUD Position"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@DropdownBox #PlayerLocationPosition { Anchor: (Width: 150, Height: 28); }
            }
          }

          Group #PlayerCaveModeHeader {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #5c8a5c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Cave Mode";
              Style: (FontSize: 18, TextColor: #5c8a5c, RenderBold: true);
            }
          }

          @SectionCard #PlayerCaveModeCard {
            Anchor: (Top: 8);
            Background: #1a2a1a(0.6);
            OutlineColor: #3a5a3a(0.5);

            @CheckboxRow {
              $C.@CheckBox #PlayerCaveModeEnabled { }
              Label { Text: "Enable Cave Mode (Personal)"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #9c4c4c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Hide Markers (Personal)";
              Style: (FontSize: 18, TextColor: #9c4c4c, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8);
            Background: #2a1a1a(0.6);
            OutlineColor: #5a3a3a(0.5);

            @CheckboxRow {
              $C.@CheckBox #PlayerHidePlayers { }
              Label { Text: "Hide Players"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #PlayerHideAllWarps { }
              Label { Text: "Hide All Warps"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #PlayerHideOtherWarps { }
              Label { Text: "Hide Other Warps"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            Label {
              Anchor: (Top: 4, Left: 2);
              Text: "Warning: Hide Other Warps requires the ExtendedTeleport mod.";
              Style: @WarningTextStyle;
            }

            @CheckboxRow {
              $C.@CheckBox #PlayerHideAllPois { }
              Label { Text: "Hide All POIs (Forgotten Temple)"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #PlayerHideSpawn { }
              Label { Text: "Hide Spawn"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #PlayerHideDeath { }
              Label { Text: "Hide Death Markers"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #PlayerHideGlobalWaypoints { }
              Label { Text: "Hide Global Waypoints"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #PlayerHidePersonalWaypoints { }
              Label { Text: "Hide Personal Waypoints"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }
          }

          TextButton #OpenWaypointsBtn {
            Anchor: (Height: 32, Top: 8);
            Text: "OPEN WAYPOINT MENU";
            Style: @NavButtonStyle;
          }

          TextButton #PlayerResetDefaultsBtn {
            Anchor: (Height: 32, Top: 6);
            Text: "RESET PLAYER SETTINGS";
            Style: @NavButtonStyle;
          }
        }
      }

      Group #AdminView {
        Visible: false;
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group {
          LayoutMode: Top;
          Padding: (Right: 8);

          Group {
            Anchor: (Height: 22);
            Padding: (Bottom: 6);

            Label {
              Text: "* Settings marked with this symbol require a server restart to take effect.";
              Style: @WarningTextStyle;
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32);
            Background: #93844c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Global Map Settings";
              Style: @SectionTitleStyle;
            }
          }

          @SectionCard {
            Anchor: (Top: 8);

            @FieldRow {
              Label { Text: "Exploration Radius"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #AdminExplorationRadius { Anchor: (Width: 120, Height: 28); }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 40, Top: 4);

              Group {
                LayoutMode: Left;
                FlexWeight: 1;

                Label { Text: "Map Quality"; Style: @FieldLabelStyle; }
                Label { Text: " *"; Style: @AsteriskLabelStyle; }
              }
              $C.@DropdownBox #AdminMapQuality { Anchor: (Width: 200, Height: $C.@DropdownBoxHeight); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Group {
                LayoutMode: Left;
                FlexWeight: 1;

                Label { Text: "Max Chunks To Load"; Style: @FieldLabelStyle; }
                Label { Text: " *"; Style: @AsteriskLabelStyle; }
              }
              $C.@NumberField #AdminMaxChunksToLoad { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Global Min Scale (Zoom Out)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #AdminMinScale { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Global Max Scale (Zoom In)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #AdminMaxScale { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Auto Save Interval (min)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #AutoSaveInterval { Anchor: (Width: 120, Height: 28); }
            }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #7a5c4c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Waypoint Limits";
              Style: (FontSize: 18, TextColor: #7a5c4c, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8);
            Background: #2a231f(0.6);
            OutlineColor: #5a4a3a(0.5);

            @FieldRow {
              Label { Text: "Max Personal Waypoints"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #AdminMaxPersonalMarkers { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Max Shared Waypoints"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #AdminMaxSharedMarkers { Anchor: (Width: 120, Height: 28); }
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #4a9c4c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Feature Toggles";
              Style: (FontSize: 18, TextColor: #4a9c4c, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8);
            Background: #1a2a23(0.6);
            OutlineColor: #3a5a4a(0.5);

            @CheckboxRow {
              $C.@CheckBox #AllowWaypointTeleport { }
              Label { Text: "Allow Waypoint Teleports"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #ShareAllExploration { }
              Label { Text: "Share All Exploration"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #LocationHudEnabled { }
              Label { Text: "Enable Location HUD (Global)"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            Label {
              Anchor: (Top: 4, Left: 2);
              Text: "Warning: If you use multiple HUD mods, please install the MultipleHUD mod.";
              Style: @WarningTextStyle;
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Default HUD Position"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@DropdownBox #AdminLocationPosition { Anchor: (Width: 150, Height: 28); }
            }

            @CheckboxRow {
              $C.@CheckBox #DebugMode { }
              Label { Text: "Debug Mode"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #4c7a9c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Player radar Settings";
              Style: (FontSize: 18, TextColor: #4c7a9c, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8);
            Background: #1a2333(0.6);
            OutlineColor: #3a4a6a(0.5);

            @CheckboxRow {
              $C.@CheckBox #RadarEnabled { }
              Label { Text: "Enable Radar"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Radar Range (-1 = infinite)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #RadarRange { Anchor: (Width: 120, Height: 28); }
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #9c4c4c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Hide Markers";
              Style: (FontSize: 18, TextColor: #9c4c4c, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8);
            Background: #2a1a1a(0.6);
            OutlineColor: #5a3a3a(0.5);

            @CheckboxRow {
              $C.@CheckBox #HidePlayers { }
              Label { Text: "Hide Players"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #HideOtherWarps { }
              Label { Text: "Hide Other Warps"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            Label {
              Anchor: (Top: 4, Left: 2);
              Text: "Warning: Hide Other Warps requires the ExtendedTeleport mod.";
              Style: @WarningTextStyle;
            }

            @CheckboxRow {
              $C.@CheckBox #HideUnexploredWarps { }
              Label { Text: "Hide Unexplored Warps"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #HideAllPois { }
              Label { Text: "Hide All POIs (Forgotten Temple)"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              $C.@CheckBox #HideUnexploredPois { }
              Label { Text: "Hide Unexplored POIs"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @FieldRow {
              Anchor: (Top: 8);
              Label { Text: "Hidden POI Names (comma sep)"; Style: @FieldLabelStyle; FlexWeight: 1; }
            }
            $C.@TextField #HiddenPoisList { Anchor: (Height: 28, Top: 4); }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #7c4c9c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "World Settings";
              Style: (FontSize: 18, TextColor: #7c4c9c, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8, Bottom: 16);
            Background: #231a2a(0.6);
            OutlineColor: #4a3a5a(0.5);

            Group {
                LayoutMode: Left;
                Anchor: (Left: 10);

                Label { Text: "Allowed Worlds (comma separated)"; Style: @CheckboxLabelStyle; }
                Label { Text: " *"; Style: @AsteriskLabelStyle; }
              }
            $C.@TextField #AllowedWorldList { Anchor: (Height: 28, Top: 4); }
            TextButton #AddCurrentWorldBtn { Anchor: (Height: 28, Top: 4); Text: "ADD CURRENT WORLD"; Style: @NavButtonStyle; }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #5c8a5c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Cave Mode Settings";
              Style: (FontSize: 18, TextColor: #5c8a5c, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8);
            Background: #1a2a1a(0.6);
            OutlineColor: #3a5a3a(0.5);

            @CheckboxRow {
              $C.@CheckBox #CaveModeEnabled { }
              Label { Text: "Enable Cave Mode (Global)"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              Anchor: (Top: 4);
              $C.@CheckBox #DiscoverSurfaceUnderground { }
              Label { Text: "Discover Surface While Underground"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @CheckboxRow {
              Anchor: (Top: 4);
              $C.@CheckBox #CaveFogOfWar { }
              Label { Text: "Cave Fog of War (Hide Surface Chunks)"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Layer Size (Y blocks)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #CaveModeLayerSize { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Underground Threshold (Y)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #CaveModeThreshold { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Cave Radius (chunks)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #CaveModeRadius { Anchor: (Width: 120, Height: 28); }
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #cc6600(0.15);
            Padding: (Left: 10);

            Label {
              Text: "World Border Settings";
              Style: (FontSize: 18, TextColor: #cc6600, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8, Bottom: 16);
            Background: #2a1f1a(0.6);
            OutlineColor: #5a4a3a(0.5);

            @CheckboxRow {
              $C.@CheckBox #WorldBorderEnabled { }
              Label { Text: "Enable World Border Visualization"; Style: @CheckboxLabelStyle; Anchor: (Left: 10); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Border Radius (blocks)"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #WorldBorderRadius { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Border Offset X"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #WorldBorderOffsetX { Anchor: (Width: 120, Height: 28); }
            }

            @FieldRow {
              Anchor: (Top: 4);
              Label { Text: "Border Offset Z"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@NumberField #WorldBorderOffsetZ { Anchor: (Width: 120, Height: 28); }
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 16);
            Background: #9c5c3c(0.15);
            Padding: (Left: 10);

            Label {
              Text: "Exploration Maintenance";
              Style: (FontSize: 18, TextColor: #c97b4d, RenderBold: true);
            }
          }

          @SectionCard {
            Anchor: (Top: 8);
            Background: #2a201a(0.6);
            OutlineColor: #5a463a(0.5);

            Label {
              Text: "Danger Zone: This clears tracked exploration for all players.";
              Style: @WarningTextStyle;
            }

            TextButton #AdminResetMapExplorationBtn {
              Anchor: (Height: 32, Top: 8);
              Text: "RESET MAP EXPLORATION (ALL PLAYERS)";
              Style: @NavButtonStyle;
            }

            TextButton #AdminResetCaveExplorationBtn {
              Anchor: (Height: 32, Top: 6);
              Text: "RESET CAVE EXPLORATION (ALL PLAYERS)";
              Style: @NavButtonStyle;
            }

            @FieldRow {
              Anchor: (Top: 8);
              Label { Text: "Saved Player"; Style: @FieldLabelStyle; FlexWeight: 1; }
              $C.@DropdownBox #AdminExplorationPlayerSelect { Anchor: (Width: 280, Height: 28); }
            }

            Label {
              Anchor: (Top: 2, Left: 2);
              Text: "Offline players are listed by UUID when username is unavailable.";
              Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
            }

            TextButton #AdminResetSelectedPlayerSurfaceExplorationBtn {
              Anchor: (Height: 32, Top: 6);
              Text: "RESET SELECTED PLAYER SURFACE";
              Style: @NavButtonStyle;
            }

            TextButton #AdminResetSelectedPlayerCaveExplorationBtn {
              Anchor: (Height: 32, Top: 6);
              Text: "RESET SELECTED PLAYER CAVE";
              Style: @NavButtonStyle;
            }
          }

          TextButton #HostingBannerBtn {
            Anchor: (Top: 24, Height: 100);
            Style: @BannerButtonStyle;
            Background: "Assets/HostingBanner.png";
          }

          TextButton #AdminResetDefaultsBtn {
            Anchor: (Height: 34, Top: 10, Bottom: 6);
            Text: "RESET ADMIN SETTINGS";
            Style: @NavButtonStyle;
          }
        }
      }
    }

    Group #AdminResetConfirm {
      Visible: false;
      Anchor: (Full: 0);
      Background: #000000(0.6);
      LayoutMode: Center;

      Group {
        Anchor: (Width: 420, Height: 180);
        Background: #1a2533(0.95);
        OutlineColor: #3a4a5a(0.8);
        OutlineSize: 1;
        LayoutMode: Top;
        Padding: (Full: 12);

        Label {
          Text: "Reset Admin Settings?";
          Style: @SectionTitleStyle;
        }

        Label {
          Anchor: (Top: 8, Width: 396);
          Text: "Tracked worlds differ from defaults. Resetting will also reset tracked worlds.";
          Style: (FontSize: 13, TextColor: #ff4a4a, RenderBold: true, VerticalAlignment: Center, Wrap: true);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 14, Height: 34);

          TextButton #AdminResetConfirmAllBtn {
            FlexWeight: 1;
            Text: "RESET ALL";
            Style: @NavButtonStyle;
          }

          Group { Anchor: (Width: 10); }

          TextButton #AdminResetConfirmKeepWorldsBtn {
            FlexWeight: 1;
            Text: "KEEP WORLDS";
            Style: @NavButtonStyle;
          }

          Group { Anchor: (Width: 10); }

          TextButton #AdminResetConfirmCancelBtn {
            FlexWeight: 1;
            Text: "CANCEL";
            Style: @NavButtonStyle;
          }

          TextButton #HostingBannerBtn {
            Anchor: (Top: 24, Height: 100);
            Style: @BannerButtonStyle;
            Background: "Assets/HostingBanner.png";
          }
        }
      }
    }

    Group #AdminExplorationResetConfirm {
      Visible: false;
      Anchor: (Full: 0);
      Background: #000000(0.6);
      LayoutMode: Center;

      Group {
        Anchor: (Width: 440, Height: 148);
        Background: #1a2533(0.95);
        OutlineColor: #3a4a5a(0.8);
        OutlineSize: 1;
        LayoutMode: Top;
        Padding: (Full: 12);

        Label {
          Text: "Confirm Exploration Reset";
          Style: @SectionTitleStyle;
        }

        Label #AdminExplorationResetConfirmMessage {
          Anchor: (Top: 8, Width: 416);
          Text: "Are you sure you want to delete all exploration data? This action is irreversible.";
          Style: (FontSize: 13, TextColor: #ff4a4a, RenderBold: true, VerticalAlignment: Center, Wrap: true);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 14, Height: 34);

          TextButton #AdminExplorationResetConfirmBtn {
            FlexWeight: 1;
            Text: "YES, DELETE";
            Style: @NavButtonStyle;
          }

          Group { Anchor: (Width: 10); }

          TextButton #AdminExplorationResetCancelBtn {
            FlexWeight: 1;
            Text: "CANCEL";
            Style: @NavButtonStyle;
          }
        }
      }
    }
  }
}

$C.@BackButton {}
