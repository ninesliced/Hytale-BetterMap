$C = "../../Common.ui";

@TransparentBtn = TextButtonStyle(
    Default: (Background: #000000(0)),
    Hovered: (Background: #FFFFFF(0.2)),
    Pressed: (Background: #FFFFFF(0.3)),
    Disabled: (Background: #000000(0)),
    Sounds: $C.@ButtonSounds
);

@NavBtn = TextButtonStyle(
    Default: (Background: #3d5a85, LabelStyle: (TextColor: #FFFFFF)),
    Hovered: (Background: #5078a8, LabelStyle: (TextColor: #FFFFFF)),
    Pressed: (Background: #2a4060, LabelStyle: (TextColor: #FFFFFF)),
    Disabled: (Background: #222222, LabelStyle: (TextColor: #666666)),
    Sounds: $C.@ButtonSounds
);

@IconBtn = TextButtonStyle(
    Default: (Background: #000000(0)),
    Hovered: (Background: #FFFFFF(0.15)),
    Pressed: (Background: #FFFFFF(0.25)),
    Disabled: (Background: #000000(0)),
    Sounds: $C.@ButtonSounds
);

@ColorBtn = TextButtonStyle(
    Default: (Background: #000000(0)),
    Hovered: (Background: #FFFFFF(0.15)),
    Pressed: (Background: #FFFFFF(0.25)),
    Disabled: (Background: #000000(0)),
    Sounds: $C.@ButtonSounds
);

$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 480, Height: 520);

    #Title {
      $C.@Title {
        @Text = "Edit Waypoint";
      }
      TextButton #BackButton {
        Anchor: (Left: 12, Top: 4, Width: 64, Height: 24);
        Text: "Back";
        Style: TextButtonStyle(
          Default: (LabelStyle: (FontSize: 14, TextColor: #93844c, RenderBold: true)),
          Sounds: $C.@ButtonSounds,
        );
        Background: #000000(0.13);
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);

      Label {
        Text: "Name";
        Style: (FontSize: 16, TextColor: #93844c, RenderBold: true); 
        Anchor: (Height: 20);
      }
      $C.@TextField #NameInput {
        Anchor: (Height: 40);
        PlaceholderText: "Waypoint Name...";
        PlaceholderStyle: (TextColor: #3d5a85, FontSize: 14);
      }

      Label {
        Text: "Coordinates (X / Y / Z)";
        Style: (FontSize: 16, TextColor: #93844c, RenderBold: true); 
        Anchor: (Height: 20);
      }
      Group #CoordsRow {
        LayoutMode: Left;
        Anchor: (Height: 40);
        $C.@TextField #InputX { FlexWeight: 1; PlaceholderText: "X"; }
        Panel { Anchor: (Width: 10, Height: 1); }
        $C.@TextField #InputY { FlexWeight: 1; PlaceholderText: "Y"; }
        Panel { Anchor: (Width: 10, Height: 1); }
        $C.@TextField #InputZ { FlexWeight: 1; PlaceholderText: "Z"; }
        Panel { Anchor: (Width: 10, Height: 1); }
        TextButton #CurrentLocationBtn {
          Anchor: (Width: 64, Height: 36, Top: 2);
          Text: "Here";
          Style: TextButtonStyle(
            Default: (Background: $C.@DefaultSquareButtonDefaultBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
            Hovered: (Background: $C.@DefaultSquareButtonHoveredBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
            Pressed: (Background: $C.@DefaultSquareButtonPressedBackground, LabelStyle: $C.@DefaultButtonLabelStyle),
            Disabled: (Background: $C.@DefaultSquareButtonDisabledBackground, LabelStyle: $C.@DefaultButtonDisabledLabelStyle),
            Sounds: $C.@ButtonSounds,
          );
        }
      }

      Label {
        Text: "Icon";
        Style: (FontSize: 16, TextColor: #93844c, RenderBold: true); 
        Anchor: (Height: 20, Top: 10);
      }
      Group #IconRow {
        LayoutMode: Left;
        Anchor: (Height: 44);
        Padding: (Top: 4);

        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Icon0Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Icon0Preview { Anchor: (Width: 28, Height: 28); Background: "Common/UserA.png"; }
          TextButton #Icon0 { Anchor: (Full: 0); Style: @IconBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Icon1Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Icon1Preview { Anchor: (Width: 28, Height: 28); Background: "Common/UserB.png"; }
          TextButton #Icon1 { Anchor: (Full: 0); Style: @IconBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Icon2Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Icon2Preview { Anchor: (Width: 28, Height: 28); Background: "Common/UserC.png"; }
          TextButton #Icon2 { Anchor: (Full: 0); Style: @IconBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Icon3Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Icon3Preview { Anchor: (Width: 28, Height: 28); Background: "Common/UserD.png"; }
          TextButton #Icon3 { Anchor: (Full: 0); Style: @IconBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Icon4Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Icon4Preview { Anchor: (Width: 28, Height: 28); Background: "Common/UserE.png"; }
          TextButton #Icon4 { Anchor: (Full: 0); Style: @IconBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Icon5Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Icon5Preview { Anchor: (Width: 28, Height: 28); Background: "Common/UserF.png"; }
          TextButton #Icon5 { Anchor: (Full: 0); Style: @IconBtn; }
        }

        Panel { Anchor: (Width: 20, Height: 1); }
        
        Label {
          Text: "Selected:";
          Style: (FontSize: 12, TextColor: #93844c);
          Anchor: (Top: 14);
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Panel #SelectedIconPreview {
          Anchor: (Width: 32, Height: 32, Top: 4);
          Background: "Common/UserA.png";
        }
      }

      Label {
        Text: "Color";
        Style: (FontSize: 16, TextColor: #93844c, RenderBold: true); 
        Anchor: (Height: 20, Top: 10);
      }
      Group #ColorRow {
        LayoutMode: Left;
        Anchor: (Height: 44);
        Padding: (Top: 4);

        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Color0Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Color0Preview { Anchor: (Width: 28, Height: 28); Background: #FFFFFF; }
          TextButton #Color0 { Anchor: (Full: 0); Style: @ColorBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Color1Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Color1Preview { Anchor: (Width: 28, Height: 28); Background: #FF4444; }
          TextButton #Color1 { Anchor: (Full: 0); Style: @ColorBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Color2Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Color2Preview { Anchor: (Width: 28, Height: 28); Background: #01EC7E; }
          TextButton #Color2 { Anchor: (Full: 0); Style: @ColorBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Color3Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Color3Preview { Anchor: (Width: 28, Height: 28); Background: #4444FF; }
          TextButton #Color3 { Anchor: (Full: 0); Style: @ColorBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Color4Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Color4Preview { Anchor: (Width: 28, Height: 28); Background: #FFFF44; }
          TextButton #Color4 { Anchor: (Full: 0); Style: @ColorBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Color5Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Color5Preview { Anchor: (Width: 28, Height: 28); Background: #FF44FF; }
          TextButton #Color5 { Anchor: (Full: 0); Style: @ColorBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Color6Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Color6Preview { Anchor: (Width: 28, Height: 28); Background: #44FFFF; }
          TextButton #Color6 { Anchor: (Full: 0); Style: @ColorBtn; }
        }
        Panel { Anchor: (Width: 6, Height: 1); }
        Group {
          Anchor: (Width: 40, Height: 40);
          Panel { Anchor: (Full: 0); Background: #2a2a2a; }
          Panel #Color7Selected { Anchor: (Full: 0); Background: #4a6a9a; Visible: false; }
          Panel #Color7Preview { Anchor: (Width: 28, Height: 28); Background: #FF8800; }
          TextButton #Color7 { Anchor: (Full: 0); Style: @ColorBtn; }
        }
      }

      Group #GlobalRow {
        LayoutMode: Left;
        Anchor: (Top: 12, Height: 28);
        Visible: false;

        $C.@CheckBox #GlobalCheckbox {
          Anchor: (Width: 24, Height: 24);
        }

        Label {
          Anchor: (Left: 8);
          Style: (FontSize: 14, TextColor: #d3d6db);
          Text: "Shared waypoint (visible to everyone)";
        }
      }

      Label #ErrorLabel {
        Anchor: (Top: 8, Height: 24);
        Text: "";
        Style: (FontSize: 13, TextColor: #ff4a4a, RenderBold: true);
        Visible: false;
      }

      Group #ActionRow {
        LayoutMode: Left;
        Anchor: (Top: 20);

        $C.@TextButton #SaveButton {
          Anchor: (Height: 28, Right: 8);
          Padding: (Left: 16, Right: 16, Top: 6, Bottom: 6);
          Text: "Save";
        }

        $C.@CancelTextButton #CancelButton {
          Anchor: (Height: 28);
          Padding: (Left: 16, Right: 16, Top: 6, Bottom: 6);
          Text: "Cancel";
        }
      }
    }
  }
}
